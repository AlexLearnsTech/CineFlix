<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarComunicacao"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/cineflix_red"
            android:title="Compartilhar filme"
            android:titleTextColor="@color/cineflix_white" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Compartilhar recomendação"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Envie uma recomendação de filme por SMS ou e-mail."
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Telefone"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editTelefone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ex.: 31999999999"
                android:inputType="phone"
                android:maxLines="1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Mensagem"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editMensagem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:hint="Mensagem"
                android:inputType="textMultiLine"
                android:minHeight="110dp"
                android:padding="10dp" />

            <Button
                android:id="@+id/btnSmsDireto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:backgroundTint="@color/cineflix_red"
                android:text="Enviar SMS diretamente"
                android:textColor="@color/cineflix_white" />

            <Button
                android:id="@+id/btnAbrirSms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Abrir aplicativo de mensagens" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="18dp"
                android:background="#33000000" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="E-mail"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ex.: pessoa@email.com"
                android:inputType="textEmailAddress"
                android:maxLines="1" />

            <Button
                android:id="@+id/btnEnviarEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Abrir aplicativo de e-mail" />

            <!-- RECEBIMENTO DE SMS -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="18dp"
                android:background="#33000000" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Recebimento de SMS"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Autorize o CineFlix a detectar mensagens SMS recebidas no dispositivo."
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textStatusRecebimentoSms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Recebimento de SMS ainda não autorizado."
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAtivarRecebimentoSms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ativar recebimento de SMS" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Último SMS recebido"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textUltimoSmsRecebido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#11000000"
                android:padding="12dp"
                android:text="Nenhum SMS recebido ainda."
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="O SMS direto exige autorização do usuário. O recebimento também utiliza uma permissão específica do Android."
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>